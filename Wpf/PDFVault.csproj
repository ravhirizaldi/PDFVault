<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <ApplicationManifest>../desktop.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PDFVault.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);WPF_DESKTOP</DefineConstants>
    <Company>Ravhi Rizaldi</Company>
    <Product>PDFVault</Product>
    <Authors>Ravhi Rizaldi</Authors>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <Compile Include="../PdfVaultDesktop.cs" Link="VaultCore.cs" />
    <!-- Runtime XAML keeps the build compatible with the installed WSL SDK. -->
    <EmbeddedResource Include="Shell.xaml" LogicalName="Shell.xaml" />
    <EmbeddedResource Include="Assets/PDFVault.ico" LogicalName="App.ico" />
  </ItemGroup>
</Project>
