<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFVault" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#F6F8FD" Foreground="#111A37"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Foreground" Value="#183163"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#AAB6D4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#4169E1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#3053BD"/>
      <Setter Property="BorderBrush" Value="#3053BD"/>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#26355B"/>
      <Setter Property="BorderBrush" Value="#768ABC"/>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="19"/>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#AF2338"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="BorderBrush" Value="#AAB6D4"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="BorderBrush" Value="#AAB6D4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="#AAB6D4"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <DataTemplate x:Key="Filename">
      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="5,3"/>
    </DataTemplate>
  </Window.Resources>
  <DockPanel LastChildFill="True" Background="#F6F8FD">
    <Border DockPanel.Dock="Top" Background="#111A37" Padding="24,15">
      <Grid>
        <TextBlock Text="PDFVault" FontSize="25" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="About" Content="_About" Style="{StaticResource HeaderButton}" Margin="0,0,12,0"/>
          <Button x:Name="MinimizeWindow" Content="—" Style="{StaticResource WindowButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="CloseWindow" Content="×" Style="{StaticResource CloseButton}" ToolTip="Close" AutomationProperties.Name="Close" Margin="4,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel x:Name="Operation" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="24,0,24,16">
      <Button x:Name="CancelWork" Content="Cancel" DockPanel.Dock="Right" Margin="12,0,0,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Phase" Margin="0,0,0,5"/>
        <ProgressBar x:Name="WorkProgress" Height="5" Foreground="#3053BD" AutomationProperties.Name="Vault operation progress"/>
      </StackPanel>
    </DockPanel>
    <TabControl x:Name="Tabs" Margin="24,20,24,22" BorderBrush="#C5CEE4" Background="White">
      <TabItem Header="_Create">
        <Grid Margin="20" x:Name="CreatePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <ComboBox x:Name="Format" SelectedIndex="0" Padding="9,6" Width="210" HorizontalAlignment="Left"
                      AutomationProperties.Name="Output format">
              <ComboBoxItem Content="Encrypted gallery (.pvault)"/>
              <ComboBoxItem Content="Use existing PDF"/>
              <ComboBoxItem Content="Generate a PDF"/>
            </ComboBox>
            <DockPanel x:Name="PdfRow" Visibility="Collapsed" Margin="0,8,0,0">
              <Button x:Name="PickPdf" Content="Browse PDF…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
              <TextBox x:Name="PdfPath" IsReadOnly="True" AutomationProperties.Name="Source PDF"/>
            </DockPanel>
          </StackPanel>
          <DockPanel Grid.Row="1" Margin="0,16,0,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button x:Name="AddPhotos" Content="Add images…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
              <Button x:Name="ClearPhotos" Content="Clear" DockPanel.Dock="Right" IsEnabled="False"/>
              <TextBlock x:Name="PhotoCount" Text="Images (0)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="Photos" ItemTemplate="{StaticResource Filename}" AutomationProperties.Name="Selected images"/>
          </DockPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><Label Content="_Passphrase" Target="{Binding ElementName=Pass}" Padding="0,0,0,5"/><PasswordBox x:Name="Pass"/></StackPanel>
            <StackPanel Grid.Column="2"><Label Content="C_onfirm passphrase" Target="{Binding ElementName=Confirm}" Padding="0,0,0,5"/><PasswordBox x:Name="Confirm"/></StackPanel>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="SaveVault" Content="Save _vault…" Style="{StaticResource Primary}" DockPanel.Dock="Right"/>
            <Button x:Name="GeneratePass" Content="Generate passphrase…" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            <TextBlock x:Name="CreateStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="_Gallery">
        <Grid Margin="20">
          <StackPanel x:Name="UnlockPanel" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <DockPanel>
              <Button x:Name="PickVault" Content="Browse vault…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
              <TextBox x:Name="VaultPath" IsReadOnly="True" AutomationProperties.Name="Vault file"/>
            </DockPanel>
            <Label Content="_Passphrase" Target="{Binding ElementName=UnlockPass}" Padding="0,0,0,5" Margin="0,14,0,0"/>
            <PasswordBox x:Name="UnlockPass"/>
            <DockPanel Margin="0,16,0,0">
              <Button x:Name="Unlock" Content="_Open gallery" Style="{StaticResource Primary}" DockPanel.Dock="Right"/>
              <TextBlock x:Name="UnlockStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
          </StackPanel>
          <Grid x:Name="Viewer" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="GalleryPhotos" AutomationProperties.Name="Gallery images">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Width="136" Margin="0,0,8,8" Padding="5" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Width="124">
                      <Border Height="85" Background="#E7ECF8" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Image}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <CheckBox Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False"
                                    IsChecked="{Binding Selected, Mode=OneWay}" Visibility="{Binding SelectionVisibility}"/>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,5,2,0"/>
                    </StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border x:Name="PhotoFrame" Visibility="Collapsed" Background="#111A37" CornerRadius="4" ClipToBounds="True">
              <ScrollViewer x:Name="PhotoScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Image preview">
                <Image x:Name="Preview" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
              </ScrollViewer>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,12,0,0">
              <Button x:Name="Lock" Content="_Lock gallery" DockPanel.Dock="Right"/>
              <Button x:Name="AddToVault" Content="Add images…" DockPanel.Dock="Right" Margin="0,0,8,0"/>
              <Button x:Name="SelectPhotos" Content="Select" DockPanel.Dock="Right" Margin="0,0,8,0"/>
              <Button x:Name="RemovePhoto" Content="Remove image…" DockPanel.Dock="Right" Margin="0,0,8,0" Visibility="Collapsed"/>
              <StackPanel x:Name="GridControls" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,12,0">
                <Button x:Name="PreviousPage" Content="Previous"/>
                <Button x:Name="NextPage" Content="Next" Margin="4,0,0,0"/>
              </StackPanel>
              <Button x:Name="BackToGrid" Content="_Back to grid" DockPanel.Dock="Left" Margin="0,0,8,0" Visibility="Collapsed"/>
              <StackPanel x:Name="ZoomControls" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,12,0" Visibility="Collapsed" IsEnabled="False">
                <Button x:Name="Fit" Content="Fit" ToolTip="Fit image to the window"/>
                <Button x:Name="ActualSize" Content="100%" Margin="4,0,0,0" ToolTip="Actual pixel size"/>
                <Button x:Name="ZoomOut" Content="−" Margin="4,0,0,0" AutomationProperties.Name="Zoom out" Padding="10,8"/>
                <Button x:Name="ZoomIn" Content="+" Margin="4,0,0,0" AutomationProperties.Name="Zoom in" Padding="10,8"/>
              </StackPanel>
              <TextBlock x:Name="Caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
          </Grid>
          <Border x:Name="GalleryLoading" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MinWidth="215" Background="White" BorderBrush="#C5CEE4" BorderThickness="1" CornerRadius="8" Padding="20,14">
            <StackPanel>
              <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold"/>
              <ProgressBar IsIndeterminate="True" Height="5" Foreground="#3053BD" AutomationProperties.Name="Loading gallery"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
